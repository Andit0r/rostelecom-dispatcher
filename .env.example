# Шаблон переменных окружения для docker compose.
# Скопируйте в .env рядом с docker-compose.yml и замените заглушки. Файл .env не коммитится.

# Название команды в интерфейсе
TEAM_NAME=непалиндром

# Бюджеты планировщика, сек
PLANNER_DAY_BUDGET_SEC=60

# Выключенные опции (on/off)
TRAFFIC_FACTORS=off
JOINT_ORDERS=off

# Аутентификация диспетчера: заглушки, задайте свои значения
DISPATCHER_LOGIN=dispatcher
DISPATCHER_PASSWORD=change-me-dispatcher
# Случайная строка для подписи токенов; пусто — секрет берётся из БД или файла auth_secret.key
AUTH_SECRET=change-me-random-string-at-least-32-chars

# Тестовые учётные записи выключены; для демо включите DEMO_ACCOUNTS=on
DEMO_ACCOUNTS=off
DEMO_PASSWORD=change-me-demo

# Пароль PostgreSQL (сервис db)
POSTGRES_PASSWORD=change-me-postgres
